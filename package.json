{
  "name": "first-light-marketing",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "cdk"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:aws": "VITE_BASE_PATH=/ npm run build",
    "build:github": "VITE_BASE_PATH=/first-light-marketing/ npm run build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test api/presence-audit.test.ts",
    "deploy": "npm run build:aws && npm -w cdk run deploy",
    "deploy:dev": "npm run build:aws && STAGE=dev npm -w cdk run deploy",
    "deploy:staging": "VITE_BASE_PATH=/ npm run build && STAGE=staging npm -w cdk run deploy"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
